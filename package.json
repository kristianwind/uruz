    "db:seed:history": "tsx scripts/seed-history.ts",
    "db:reset": "tsx scripts/reset-local.ts",
    "setup": "tsx scripts/setup.ts",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "gen:vapid": "tsx scripts/gen-vapid.ts",
    "gen:screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "clsx": "^2.1.1",
    "next": "^15.5.0",
    "nodemailer": "^9.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.0",
    "resend": "^4.7.0",
    "server-only": "^0.0.1",
