# ─────────────────────────────────────────────────────────────────────────
# Uruz environment configuration
# Copy this file to `.env.local` and fill in the values you have. The local
# development stack runs with NONE of these set (it uses a built-in SQLite DB
# and stubs external services), so you can start immediately and add keys as
# you enable features. See README.md for what each unlocks.
# ─────────────────────────────────────────────────────────────────────────

# --- Data backend --------------------------------------------------------
# "sqlite" (default, zero-setup local dev) or "supabase" (production).
DATA_BACKEND=sqlite
# Where the local SQLite file lives (sqlite backend only).
URUZ_SQLITE_PATH=.data/uruz.sqlite
# Auto-login as the demo admin in dev when there's no session (dev only).
URUZ_DEV_AUTOLOGIN=true

# --- Supabase (production data + auth) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL / passkeys (WebAuthn) ---------------------------------------
# Public origin of the app; used for WebAuthn relying-party + magic links.
# Optional: left blank (or still on localhost) the app derives it from the
# request's x-forwarded-host, which is right behind a reverse proxy. Set it to
# pin the address — an explicitly set origin always wins.
NEXT_PUBLIC_APP_URL=
# Relying Party ID for passkeys (the registrable domain, no scheme/port).
# Derived from the address above; only set it to deliberately share one
# credential across subdomains (and it must then be a real parent domain).
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Uruz
# Mount path when embedded under the Yggdrasil Panel, e.g. /uruz. Leave blank
# for a standalone deployment.
NEXT_PUBLIC_BASE_PATH=

# --- Kvasir (AI coach) — vælg frit mellem udbydere -------------------------
# Uruz er ikke bundet til én leverandør. Sæt AI_PROVIDER til en af:
#   anthropic | openai | google | ollama | custom | none
# "custom" dækker enhver OpenAI-kompatibel server (llama.cpp, llama-swap,
# LM Studio, vLLM, Groq, OpenRouter, Together …) — også uden API-nøgle.
#
# Uden konfiguration kører Kvasir videre på regelbaserede forslag udledt af
# dine egne tal — appen virker altså fint uden nogen model.
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Reasoning-modeller (Gemma/Qwen/DeepSeek) "tænker" først, hvilket er langsomt.
# Slås fra som standard på selvhostede servere; sæt til false for at bevare det.
AI_DISABLE_THINKING=true
#
# Eksempel — selvhostet model på eget net (ingen nøgle):
#   AI_PROVIDER=custom
#   AI_BASE_URL=http://din-server.lan:8080/v1
#   AI_MODEL=gemma-4-26b-qat
#
# Eksempel — Anthropic:
#   AI_PROVIDER=anthropic
#   AI_MODEL=claude-sonnet-5
#   AI_API_KEY=sk-ant-…

# --- Email — invitations, sign-in links & reminders ----------------------
# Two ways out; SMTP wins if both are filled in. Neither: messages (and their
# links) are printed to the server log, which is enough to work locally.
#
# SMTP — any mail server: your own, your host's, or Gmail with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave blank to derive from the port: 465 means implicit TLS, everything else
# starts plaintext and upgrades with STARTTLS. Set true/false to override.
SMTP_SECURE=
#
# Resend — an API key instead of a mail server.
RESEND_API_KEY=
#
# Sender address. Many providers reject a From they don't consider yours.
EMAIL_FROM="Uruz <ravne@uruz.local>"

# --- Web Push (VAPID) — reminders when the app is closed ------------------
# Generate a keypair with: npm run gen:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@uruz.local

# --- Background jobs -----------------------------------------------------
# Shared secret that protects the cron endpoints (weekly analysis, reminders).
CRON_SECRET=
